# Copy to .env and fill in. NEVER commit .env.
# The file-only mode (--signal file) needs none of these.
# The IMAP/SMTP modes and crypto read them from the environment.

# --- IMAP (shared-mailbox mode) ---
# Use a dedicated mailbox and an app-specific password, never your main password.
P2P_IMAP_HOST=
P2P_IMAP_USER=
P2P_IMAP_PASSWORD=
# Fresh folder per test session; old messages in a reused folder slow the
# responder down (they are rejected by ts, but still fetched).
P2P_IMAP_FOLDER=p2p-demo
# 126/163/yeah.net: the IMAP ID command is sent automatically.
# Set 1 to force it, 0 to disable it; leave empty for auto.
P2P_IMAP_ID=

# --- SMTP (peer-to-peer email mode, experimental) ---
# Implicit TLS on 465. Use a mailbox with SPF/DKIM, or mail will be filtered.
P2P_SMTP_HOST=
P2P_SMTP_PORT=465
P2P_SMTP_STARTTLS=0
P2P_MY_EMAIL=
P2P_PEER_EMAIL=
P2P_SMTP_FOLDER=INBOX

# --- Pre-shared key (32 bytes, base64) ---
# Generate with:
#   python3 scripts/gen_psk.py --out .env
# or:
#   python3 -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
# Keep it out of git and out of shell history if possible.
P2P_PSK_B64=
